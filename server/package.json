{
  "name": "ordini-scout-server",
  "version": "1.0.0",
  "description": "Backend per gestione ordini scout",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "dev:simple": "cross-env NODE_ENV=development node server.js",
    "build": "node --check server.js && node --check database.js",
    "migrate:postgres": "node migrate-sqlite-to-postgres.js"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "nodemailer": "^6.9.7",
    "pg": "^8.23.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
